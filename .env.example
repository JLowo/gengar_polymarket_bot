# Gengar / PolyBot settings
#
#   cp .env.example .env      (.env is git-ignored; never commit it)
#
# Every variable the bot reads is listed below.
#  - Empty lines (KEY=) are yours to fill in: wallet and Telegram.
#  - Commented-out lines show the code's built-in default. Leave them commented
#    to use the default; uncomment one only to change its value.
#  - Don't leave an uncommented setting empty: numbers fail to parse, and an
#    empty DRY_RUN means LIVE trading.

# ── Wallet (live mode only; DRY_RUN needs neither) ──────────────────
# Private key of the wallet that signs orders. Controls your funds.
PRIVATE_KEY=
# Polymarket Safe (proxy wallet) address. Leave empty for a plain EOA wallet.
SAFE_ADDRESS=

# Builder API key, only needed for the bot to redeem winnings itself.
# Create it with: .venv/bin/python preflight.py --create-builder-key
# (it saves these three lines for you). Empty = claim winnings in the UI.
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# ── Telegram alerts (optional; leave both empty to disable) ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Mode ────────────────────────────────────────────────────────────
# "true" simulates trades (no wallet or Tor needed). Any other value,
# including empty, is LIVE trading with real USDC.
DRY_RUN=true

# ── Market and strategy ─────────────────────────────────────────────
# Market length in minutes (5 or 15)
# MARKET_PERIOD=5
# Minimum edge (model probability minus market price) to trade
# MIN_EDGE=0.05
# Minimum model probability to trade
# MIN_PROB=0.80
# Minimum BTC move from the window open, in percent
# MIN_BTC_DELTA=0.06
# Seconds before the window closes to start / stop looking for entries
# ENTRY_WINDOW_START=240
# ENTRY_WINDOW_END=10
# Fraction of the Kelly bet to stake, and the bet size limits in USD
# KELLY_FRACTION=0.25
# MIN_BET=5.0
# MAX_BET=25.0
# Starting bankroll in USD; set it to your real Polymarket USDC balance
# BANKROLL=100.0

# ── Volatility (rolling estimate from recent windows) ───────────────
# Number of recent windows used for the estimate, and its lower/upper bounds
# ROLLING_VOL_WINDOWS=12
# VOL_FLOOR=0.06
# VOL_CAP=0.30

# ── Safety ──────────────────────────────────────────────────────────
# Halt trading once the session has lost this many USD
# DAILY_LOSS_LIMIT=30.0

# ── Logging ─────────────────────────────────────────────────────────
# Folder for signals.csv, trades.csv and the other logs
# LOG_DIR=logs
# Also write executions.csv (raw order details)
# LOG_EXECUTIONS=false

# Note: SAFETY_FACTOR appears in the docs, but the code doesn't read it.
